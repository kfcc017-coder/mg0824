<body>
  <main class="app">
    <header class="header">
      <div class="title-badge">사내 업무 도우미</div>
      <h1>업무 FAQ 검색</h1>
      <p class="subtitle">
        질문이나 키워드를 입력해서 필요한 FAQ를 빠르게 찾아보세요.
      </p>
    </header>

    <section class="search-panel" aria-label="FAQ 검색 및 필터">
      <div class="search-row">
        <input
          id="searchInput"
          class="search-input"
          type="search"
          placeholder="질문이나 키워드를 입력하세요."
          aria-label="FAQ 검색어"
          autocomplete="off"
        />
        <button id="viewAllBtn" class="view-all-btn" type="button">
          전체보기
        </button>
      </div>

      <div id="filters" class="filters" aria-label="분류 선택"></div>
    </section>

    <section aria-live="polite">
      <div class="results-header">
        <h2 class="results-title">검색 결과</h2>
        <span id="resultCount" class="result-count"></span>
      </div>
      <div id="resultList" class="result-list"></div>
    </section>
  </main>

  <script>
    const faqData = [
  {
    "category": "교육",
    "question": "교육 신청은 어디에서 하나요?",
    "answer_seed": "교육 포털의 과정 검색 후 신청 메뉴를 사용합니다."
  },
  {
    "category": "교육",
    "question": "신청한 교육을 취소하려면 어떻게 하나요?",
    "answer_seed": "신청내역에서 취소 가능 여부를 확인합니다."
  },
  {
    "category": "문서",
    "question": "주간 업무보고에는 무엇을 넣어야 하나요?",
    "answer_seed": "주요 실적, 이슈, 다음 주 계획을 중심으로 작성합니다."
  },
  {
    "category": "IT",
    "question": "사내 시스템 접속이 되지 않습니다.",
    "answer_seed": "네트워크, 브라우저, 계정 상태를 순서대로 확인합니다."
  },
  {
    "category": "보안",
    "question": "ChatGPT에 내부 업무자료를 넣어도 되나요?",
    "answer_seed": "교육에서는 합성자료를 사용하고, 실제 자료는 조직의 보안 및 AI 사용 기준을 먼저 확인합니다."
  },
  {
    "category": "교육",
    "question": "교육장소는 어디인가요?",
    "answer_seed": "신논현역과 논현역 사이입니다."
  },
  {
    "category": "개인",
    "question": "점심메뉴는 무엇인가요?",
    "answer_seed": "한식 양식 일실중 선택할수있습니다."
  }
];

    const searchInput = document.getElementById("searchInput");
    const viewAllBtn = document.getElementById("viewAllBtn");
    const filters = document.getElementById("filters");
    const resultList = document.getElementById("resultList");
    const resultCount = document.getElementById("resultCount");

    let selectedCategory = "전체";

    const categories = [
      "전체",
      ...new Set(faqData.map(item => item.category))
    ];

    function escapeHtml(value) {
      return String(value).replace(/[&<>'"]/g, char => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        "'": "&#039;",
        '"': "&quot;"
      })[char]);
    }

    function escapeRegExp(value) {
      return value.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
    }

    function highlight(text, keyword) {
      const safeText = escapeHtml(text);
      const trimmed = keyword.trim();

      if (!trimmed) return safeText;

      const pattern = new RegExp(
        `(${escapeRegExp(trimmed)})`,
        "gi"
      );

      return safeText.replace(pattern, "<mark>$1</mark>");
    }

    function renderFilters() {
      filters.innerHTML = categories.map(category => `
        <button
          class="filter-btn ${category === selectedCategory ? "active" : ""}"
          type="button"
          data-category="${escapeHtml(category)}"
        >
          ${escapeHtml(category)}
        </button>
      `).join("");

      filters.querySelectorAll(".filter-btn").forEach(button => {
        button.addEventListener("click", () => {
          selectedCategory = button.dataset.category;
          renderFilters();
          renderFaqs();
        });
      });
    }

    function renderFaqs() {
      const keyword = searchInput.value.trim();
      const normalizedKeyword = keyword.toLocaleLowerCase("ko-KR");

      const filtered = faqData.filter(item => {
        const categoryMatch =
          selectedCategory === "전체" ||
          item.category === selectedCategory;

        const searchableText =
          `${item.question} ${item.answer_seed} ${item.category}`
            .toLocaleLowerCase("ko-KR");

        const keywordMatch =
          !normalizedKeyword ||
          searchableText.includes(normalizedKeyword);

        return categoryMatch && keywordMatch;
      });

      resultCount.textContent = `총 ${filtered.length}건`;

      if (filtered.length === 0) {
        resultList.innerHTML = `
          <div class="empty-state">
            <strong>검색 결과가 없습니다.</strong>
            FAQ에 등록된 다른 키워드나 분류로 검색해 주세요.
          </div>
        `;
        return;
      }

      resultList.innerHTML = filtered.map(item => `
        <article class="faq-card">
          <span class="category-badge">
            ${highlight(item.category, keyword)}
          </span>

          <h3 class="question">
            ${highlight(item.question, keyword)}
          </h3>

          <p class="answer">
            ${highlight(item.answer_seed, keyword)}
          </p>
        </article>
      `).join("");
    }

    searchInput.addEventListener("input", renderFaqs);

    viewAllBtn.addEventListener("click", () => {
      searchInput.value = "";
      selectedCategory = "전체";
      renderFilters();
      renderFaqs();
      searchInput.focus();
    });

    renderFilters();
    renderFaqs();
  </script>
</body>
</html>
